{
  "name": "semantic-golfer",
  "private": true,
  "version": "0.0.0",
  "main": "./dist-electron/index.js",
  "type": "module",
  "files": [
    "dist",
    "dist-electron",
    "dist-cli",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://giladgd.github.io/semantic-golfer/",
  "scripts": {
    "start": "vite dev",
    "start:inspect": "cross-env ENABLE_INSPECT=true vite dev",
    "start:build": "electron ./dist-electron",
    "prebuild": "rimraf ./dist ./dist-electron ./release",
    "build": "tsc --noEmit && vite build && electron-builder --config ./electron-builder.ts --publish never",
    "prebuild:npm": "rimraf ./dist ./dist-electron ./dist-cli ./npm-package",
    "build:npm": "tsc --noEmit && vite build && tsc -p tsconfig.cli.json && node scripts/prepareNpmPackage.ts",
    "start:site": "vite --config site/vite.config.ts",
    "build:site": "tsc --noEmit -p tsconfig.site.json && node scripts/buildSite.ts",
    "preview:site": "vite preview --config site/vite.config.ts",
    "update:site-images": "electron scripts/updateSiteImages.ts",
    "update:readme-demo": "electron scripts/updateReadmeDemo.ts",
    "record:demo": "node scripts/recordLandingDemo.ts",
    "lint": "npm run lint:eslint",
    "lint:eslint": "eslint --report-unused-disable-directives .",
    "format": "npm run lint:eslint -- --fix",
    "clean": "rm -rf ./node_modules ./dist ./tsconfig.tsbuildinfo ./dist-electron ./dist-cli ./dist-site ./npm-package ./release ./models",
    "test": "node --experimental-strip-types --experimental-test-module-mocks --test test/*.test.ts",
    "test:semantic-lock": "node --experimental-strip-types test/semantic-lock.eval.ts",
    "test:levels": "node test/levels.eval.ts",
    "release:plan": "node scripts/release.ts --dry-run",
    "release": "node scripts/release.ts"
  },
  "author": {
    "name": "Gilad S.",
    "url": "https://github.com/giladgd",
    "email": "giladgd@users.noreply.github.com"
  },
  "license": "MIT",
  "preferUnplugged": true,
  "bugs": {
    "url": "https://github.com/giladgd/semantic-golfer/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/giladgd"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "birpc": "^4.0.0",
    "electron-updater": "^6.8.9",
    "lifecycle-utils": "^4.5.1",
    "node-llama-cpp": "^3.22.1",
    "pretty-ms": "^9.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "semver": "^7.8.5"
  },
  "allowScripts": {
    "node-llama-cpp": true
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@stylistic/eslint-plugin": "^5.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "builder-util": "^26.15.3",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.5.5",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-svgr": "^5.2.0"
  },
  "productName": "Semantic Golfer",
  "desktopName": "semantic-golfer.desktop",
  "description": "Play with meaning and explore fast, local AI structured decisions.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giladgd/semantic-golfer.git"
  },
  "engines": {
    "node": ">=24.10.0"
  }
}
